El flujo completo en palabras
Excelente pregunta, este es uno de los problemas más complejos del sistema. Te explico todo el pipeline.
El Problema Real
Los PDFs del ICFES tienen 3 tipos de imágenes:
Tipo 1 → Imagen decorativa/contexto (una foto para un texto de lectura)
Tipo 2 → Imagen ES la pregunta (una gráfica, tabla, figura geométrica)
Tipo 3 → Imagen está DENTRO de una opción de respuesta
El tipo 2 y 3 son los críticos — sin la imagen la pregunta es imposible de responder.

Pipeline Completo de Extracción
Paso 1: Extraer el PDF con precisión
La mejor herramienta para PDFs del ICFES es pdfplumber combinado con pymupdf (fitz):
pythonimport fitz  # pymupdf
import pdfplumber
import json
import base64
from pathlib import Path

def extract_icfes_pdf(pdf_path: str, area: str, year: int):
    doc = fitz.open(pdf_path)
    questions = []
    
    with pdfplumber.open(pdf_path) as plumber:
        for page_num, page in enumerate(plumber.pages):
            # Extraer texto con coordenadas exactas (bbox)
            words = page.extract_words(
                x_tolerance=3,
                y_tolerance=3,
                keep_blank_chars=False,
                use_text_flow=True,
                extra_attrs=["fontname", "size"]  # detectar negrilla = enunciado
            )
            
            # Extraer imágenes de la misma página con pymupdf
            fitz_page = doc[page_num]
            images = extract_images_from_page(fitz_page, page_num)
            
            # Asociar texto e imágenes por posición Y en la página
            questions += associate_text_and_images(words, images, page_num)
    
    return questions
Paso 2: Extraer imágenes con su posición exacta
pythondef extract_images_from_page(fitz_page, page_num: int) -> list:
    images = []
    image_list = fitz_page.get_images(full=True)
    
    for img_index, img in enumerate(image_list):
        xref = img[0]
        
        # Obtener bbox (posición) de la imagen en la página
        # Esto es CLAVE para saber a qué pregunta pertenece
        img_rects = fitz_page.get_image_rects(xref)
        
        for rect in img_rects:
            # Extraer imagen como bytes
            base_image = fitz_page.parent.extract_image(xref)
            img_bytes = base_image["image"]
            img_ext = base_image["ext"]  # png, jpeg
            
            # Convertir a base64 para guardar en BD
            img_b64 = base64.b64encode(img_bytes).decode("utf-8")
            
            images.append({
                "index": img_index,
                "page": page_num,
                "bbox": {
                    "x0": rect.x0,
                    "y0": rect.y0,  # posición vertical = clave
                    "x1": rect.x1,
                    "y1": rect.y1
                },
                "data": f"data:image/{img_ext};base64,{img_b64}",
                "ext": img_ext,
                "width": rect.width,
                "height": rect.height
            })
    
    return images
Paso 3: Asociar imagen a pregunta por posición Y
Este es el paso más delicado. La lógica es: una imagen pertenece a la pregunta cuyo enunciado está más cercano por encima de ella.
pythondef associate_text_and_images(words: list, images: list, page_num: int) -> list:
    # Detectar inicio de cada pregunta por patrón "1." "2." etc.
    question_boundaries = []
    
    for word in words:
        import re
        if re.match(r'^\d{1,2}\.$', word['text']):
            question_boundaries.append({
                "number": int(word['text'].rstrip('.')),
                "y_start": word['top'],
                "y_end": None  # se llena con el inicio de la siguiente
            })
    
    # Calcular y_end de cada pregunta
    for i, q in enumerate(question_boundaries):
        if i + 1 < len(question_boundaries):
            q["y_end"] = question_boundaries[i + 1]["y_start"]
        else:
            q["y_end"] = 9999  # última pregunta de la página
    
    # Asignar cada imagen a la pregunta cuyo rango Y la contiene
    for image in images:
        img_y_center = (image["bbox"]["y0"] + image["bbox"]["y1"]) / 2
        
        for q in question_boundaries:
            if q["y_start"] <= img_y_center <= q["y_end"]:
                if "images" not in q:
                    q["images"] = []
                
                # Clasificar posición de la imagen dentro de la pregunta
                q["images"].append({
                    **image,
                    "position": classify_image_position(image, words, q)
                })
                break
    
    return question_boundaries

def classify_image_position(image, words, question):
    # Determinar si la imagen va ANTES de las opciones o DENTRO de una opción
    options_y = get_options_y_position(words, question)
    
    if image["bbox"]["y0"] < options_y:
        return "stem"      # imagen es parte del enunciado
    else:
        return "option"    # imagen es una de las opciones A/B/C/D


# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Supabase Configuration
# Get these values from your Supabase project settings
# Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# Security
# Generate strong random keys for production:
# PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Linux/Mac: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters
API_KEY=change-this-to-your-secure-api-key
ENCRYPTION_KEY=change-this-32-char-encryption

# Google OAuth — Verificación criptográfica de Google ID Tokens
# Obtener en: https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Debe coincidir con el client_id configurado en la app Android/Web
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# RAG Configuration
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
EMBEDDING_MODEL=text-embedding-ada-002
# Embedding dimensions MUST match the DB vector column size (default: 4096)
EMBEDDING_DIMENSIONS=4096
# OpenRouter embedding model (native dimension should match EMBEDDING_DIMENSIONS)
# OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE=logs/mcp-server.log

# CORS
ALLOWED_ORIGINS=http://localhost:*,http://10.0.2.2:*,http://192.168.*.*

# Firebase Cloud Messaging (FCM) — Push Notifications
# Option 1: Individual env vars
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Option 2: Full service account JSON as a single env var
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Option 3: Place a service account JSON file in the project root
# (e.g. firebase-service-account.json or serviceAccountKey.json)

# Ollama Configuration (Optional)
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=llama3

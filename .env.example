# ============================================================
# EXAMPLE ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials
# ============================================================

# Core Configuration
HOST=0.0.0.0
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.com

# Security - CHANGE THESE VALUES!
# Generate strong random keys:
# PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Linux/Mac: openssl rand -base64 32
API_KEY=your-secure-api-key-min-32-characters
JWT_SECRET=your-secure-jwt-secret-min-32-characters
ENCRYPTION_KEY=your-32-character-encryption-key
ALLOWED_ORIGINS=https://your-frontend.com

# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# DeepSeek AI
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
USE_LLM=true

# Email - Resend
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Firebase Push Notifications
# Download service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Cloudflare R2 Storage (Optional)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxx.r2.dev

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# RAG Configuration (Optional)
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
EMBEDDING_MODEL=text-embedding-ada-002

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE=logs/mcp-server.log

# CORS
ALLOWED_ORIGINS=http://localhost:*,http://10.0.2.2:*,http://192.168.*.*

# Ollama Configuration (Optional)
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=llama3

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Supabase Configuration
# Get these values from your Supabase project settings
# Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# Security
# Generate strong random keys for production:
# PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Linux/Mac: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters
API_KEY=change-this-to-your-secure-api-key
ENCRYPTION_KEY=change-this-32-char-encryption

# Google OAuth — Verificación criptográfica de Google ID Tokens
# Obtener en: https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Debe coincidir con el client_id configurado en la app Android/Web
# Soporta múltiples Client IDs separados por coma (web + Android)
GOOGLE_CLIENT_ID=650106105156-2pc3eojksd6ino17oghdouncb25ub75h.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# RAG Configuration
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
EMBEDDING_MODEL=text-embedding-ada-002
# Embedding dimensions MUST match the DB vector column size (default: 4096)
EMBEDDING_DIMENSIONS=4096
# OpenRouter embedding model (native dimension should match EMBEDDING_DIMENSIONS)
# OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# OpenRouter image generation model for course/subject thumbnails (realistic images via FLUX)
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE=logs/mcp-server.log

# CORS
ALLOWED_ORIGINS=http://localhost:*,http://10.0.2.2:*,http://192.168.*.*

# Firebase Cloud Messaging (FCM) — Push Notifications
# Option 1: Individual env vars
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Option 2: Full service account JSON as a single env var
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Option 3: Place a service account JSON file in the project root
# (e.g. firebase-service-account.json or serviceAccountKey.json)

# Ollama Configuration (Optional)
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=llama3

# Multi-Tenant Configuration
# Each server registers itself via the primary SUPABASE_* vars.
# Additional tenants are auto-discovered from TENANT_<ID>_* env vars.
# The <ID> suffix must be UPPERCASE (e.g. INCAT, PRODX).
# Both servers should carry credentials for ALL tenants so the
# cross-tenant WhatsApp session lookup can probe every institution DB.
#
# QA / Develop server → primary is vxuksizvwrkctrvpciyp
# SUPABASE_URL=https://vxuksizvwrkctrvpciyp.supabase.co
# SUPABASE_SERVICE_KEY=<qa-develop service_role key>
# Add INCAT as secondary:
TENANT_INCAT_SUPABASE_URL=https://gzckzrocfmhsizlrnqep.supabase.co
TENANT_INCAT_SUPABASE_SERVICE_KEY=your-incat-service-role-key-here
#
# Production / INCAT server → primary is gzckzrocfmhsizlrnqep
# SUPABASE_URL=https://gzckzrocfmhsizlrnqep.supabase.co
# SUPABASE_SERVICE_KEY=<incat service_role key>
# Add QA as secondary:
# TENANT_QADEV_SUPABASE_URL=https://vxuksizvwrkctrvpciyp.supabase.co
# TENANT_QADEV_SUPABASE_SERVICE_KEY=your-qa-service-role-key-here

# Sign Language Detection — prithivMLmods/Alphabet-Sign-Language-Detection
# Se sirve LOCALMENTE con @huggingface/transformers (ONNX). Para generar y
# distribuir los pesos:
#   1) python scripts/convert_sign_language_to_onnx.py
#   2) python scripts/upload_sign_language_to_hf.py <user>/<repo>
# El Dockerfile de producción no genera el ONNX durante el build; usa un repo
# remoto o artefactos ya preconstruidos en models/sign-language/.
# Y en producción:
#   SIGN_LANGUAGE_HF_REPO=<user>/Alphabet-Sign-Language-ONNX
# Variables opcionales:
#   SIGN_LANGUAGE_MODEL_DIR   Ruta local (default: <repo>/models/sign-language)
#   SIGN_LANGUAGE_HF_REPO     Repo HF a descargar si no hay artefactos locales
#   SIGN_LANGUAGE_CACHE_DIR   Cache para descargas (default: /tmp/transformers-cache)
#   SIGN_LANGUAGE_DISABLED    "true" para desactivar el endpoint
#   HF_API_TOKEN              Token HF, solo si SIGN_LANGUAGE_HF_REPO es privado
# HF_API_TOKEN=your-huggingface-api-token

# OpenRouter API Configuration (Required for VLM-based sign language recognition)
# Get your API key from: https://openrouter.ai/keys
# Required for: LSC detection, numbers, phrases, sentences, motion recognition
OPENROUTER_API_KEY=your-openrouter-api-key-here
# VLM model for sign language (default: google/gemini-2.5-flash)
# SIGN_LANGUAGE_VLM_MODEL=google/gemini-2.5-flash
# Sign language profile: "asl" (American) or "lsc" (Colombian/Spanish)
# For Colombian Sign Language, use "lsc"
SIGN_LANGUAGE_PROFILE=lsc
